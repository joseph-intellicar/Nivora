# Copy to .env and fill in. Never commit .env.

# Neon pooled connection string (host contains "-pooler") — used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct connection string (same host without "-pooler") — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# API port (the Next.js app proxies /api/* here).
PORT=4000

# The frontend origin: mutating requests from any other origin are rejected (CSRF defence).
FRONTEND_ORIGIN="http://localhost:3000"

# Cookie Secure flag: false for local http, true in production (https).
COOKIE_SECURE=false

# Session lifetime in days.
SESSION_TTL_DAYS=30

# development | test | production
NODE_ENV=development
