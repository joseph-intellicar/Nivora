# Copy to .env.local and adjust as needed. All values are optional; defaults live in src/config/site.ts.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Public base URL, used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source for the data layer: "mock" (Phase 1, browser storage, no backend needed) or
# "http" (Phase 2: the Nivora API at BACKEND_URL). Inlined at build time — rebuild after changing.
NEXT_PUBLIC_DATA_SOURCE=mock

# Backend base URL (server-side only), used when NEXT_PUBLIC_DATA_SOURCE=http: Server Components
# call it directly and next.config.ts proxies the browser's /api/* to it. Read at build time.
BACKEND_URL=http://localhost:4000

# Simulated latency (ms) for mock customer-data calls. Use 0 to disable.
NEXT_PUBLIC_MOCK_LATENCY_MS=250

# Search engine indexing. Keep false while Nivora uses mock data.
NEXT_PUBLIC_ALLOW_INDEXING=false
